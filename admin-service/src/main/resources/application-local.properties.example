# Copier vers application-local.properties (non versionne, deja dans .gitignore)
#
# --- MongoDB Atlas ---
# 1) Atlas > Network Access : ton IP (ou 0.0.0.0/0 en dev).
# 2) Database Access : user + mot de passe.
# 3) Cluster > Connect > Drivers : URI mongodb+srv (encoder le mot de passe en URL).
# 4) Meme base, ex. althea_systems_db, pour catalog + admin.
#
# spring.mongodb.uri=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/althea_systems_db?retryWrites=true&w=majority&appName=althea
# spring.data.mongodb.uri=${spring.mongodb.uri}
#
# Option : MONGODB_URI=mongodb+srv://... (variable d'environnement)
#
spring.mongodb.uri=
