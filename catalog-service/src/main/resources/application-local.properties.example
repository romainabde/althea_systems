# Copier vers application-local.properties (non versionne, deja dans .gitignore)
#
# --- MongoDB Atlas (recommande) ---
# 1) Atlas > Project > Clusters : creer/choisir un cluster.
# 2) Network Access : authoriser ton IP (ou 0.0.0.0/0 en dev seulement).
# 3) Database Access : user + mot de passe.
# 4) Cluster > Connect > Drivers : copier l'URI mongodb+srv://...
#    Remplacer <password> (encoder les caracteres speciaux du mot de passe en URL).
# 5) Meme base que ton app, ex. althea_systems_db (suffixe de l'URI /nom_de_la_base)
#
# spring.data.mongodb.uri=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/althea?retryWrites=true&w=majority&appName=althea
#
# Option : variable d'environnement (CI, IDE) au lieu de ce fichier
#   MONGODB_URI=mongodb+srv://...
#
spring.data.mongodb.uri=
