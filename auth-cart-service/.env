# =============================================================================
# auth-cart-service — variables d'environnement (local / dev)
# Ce fichier est ignoré par Git (.gitignore). Ne commite pas de secrets réels.
# =============================================================================

# --- Serveur ---
PORT=8080

# --- Obligatoire pour JWT (login, panier avec token, etc.) ---
JWT_SECRET=change-moi-en-secret-long-et-aleatoire-pour-le-dev

# --- URL du front (liens e-mail de confirmation, reset password, etc.) ---
FRONTEND_URL=http://localhost:3000

# --- Stripe (utilisé pour confirmPayment / checkout réel) ---
# Remplace par ta clé test depuis le dashboard Stripe si tu testes le paiement.
# Sans clé valide, le serveur peut échouer au démarrage (instanciation Stripe).
STRIPE_KEY=sk_test_51TPKJ501FMkwCmGJNaVibWu2EDBklpRrCF0NEzgm9Ud5tK5edAGGj6DWwyjw7Ie1rYMBDXR9M7ajdqK8fa08vF7k00k9nGqtwq

# --- E-mail (nodemailer — optionnel tant que tu n'envoies pas de mails) ---
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=

# --- Base Prisma / Neon (PostgreSQL) — même base que admin/catalog du projet ---
